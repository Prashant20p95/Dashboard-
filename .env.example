# ─────────────────────────────────────────────────────────────────────────────
# OpsCommand — Environment Configuration Template
# Copy this file to .env and adjust values for your organization.
# ─────────────────────────────────────────────────────────────────────────────

# Organization & Portal Branding
ORGANIZATION_NAME=Global Logistics Operations
PORTAL_TITLE=Operations & Consignment Dispatch Command
PORTAL_SUBTITLE=Pan-Region Distribution, Consignment Dispatch & Physical Verification System
APP_VERSION=2.0.0

# Operations Desk Contact Details
SUPPORT_PHONE=+91 98765 43210
SUPPORT_EMAIL=operations@company.com
DEFAULT_CURRENCY=INR

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Database Configuration (SQLite default; switch to PostgreSQL if desired)
# SQLite:
DATABASE_URL=sqlite:///operations.db
# PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/opscommand

# Operational Thresholds
# Highlight destinations whose deadline is within N days without verified delivery
AT_RISK_THRESHOLD_DAYS=3
